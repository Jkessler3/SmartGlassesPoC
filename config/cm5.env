# Raspberry Pi Compute Module 5 Lite hardware profile
DEVICE_PROFILE=cm5
SMARTGLASSES_CAMERA_BACKEND=picamera2
# CM5 CAM/DISP 0 has Arducam UC-B47 / IMX708 and maps to Picamera2/libcamera camera 0.
SCENE_CAMERA_CONNECTOR=CAM/DISP0
SCENE_CAMERA=0
# CM5 CAM/DISP 1 has OV9281 and maps to Picamera2/libcamera camera 1.
EYE_CAMERA_CONNECTOR=CAM/DISP1
ENABLE_EYE_CAMERA=1
EYE_CAMERA=1
SMARTGLASSES_OUTDIR=/home/user/poc_out
STREAM_HOST=0.0.0.0
STREAM_PORT=8000
BUTTON_GPIO=17
STATUS_LED_GPIO=27
ENABLE_PI_GPIO=0
USE_LIBCAMERA=1
USE_USB_CAMERA=0
