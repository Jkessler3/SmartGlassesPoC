# Raspberry Pi Compute Module 5 Lite hardware profile
DEVICE_PROFILE=cm5
SMARTGLASSES_CAMERA_BACKEND=picamera2
# CM5 CAM/DISP 0 maps to Picamera2/libcamera camera 0.
SCENE_CAMERA_CONNECTOR=CAM/DISP0
SCENE_CAMERA=0
EYE_CAMERA=1
SMARTGLASSES_OUTDIR=/home/user/poc_out
BUTTON_GPIO=17
STATUS_LED_GPIO=27
ENABLE_PI_GPIO=0
USE_LIBCAMERA=1
USE_USB_CAMERA=0
