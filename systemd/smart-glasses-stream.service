[Unit]
Description=Smart Glasses Pi camera stream
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/SmartGlassesPoC
ExecStart=/home/user/SmartGlassesPoC/scripts/run_cm5_stream.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
